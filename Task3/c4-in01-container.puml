@startuml c4-in01-container
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
skinparam backgroundColor #FFFFFF
AddRelTag("trust", $lineColor="#C0392B", $textColor="#C0392B", $lineStyle=DashedLine(), $legendText="граница доверия ГД-N")
AddElementTag("existing", $bgColor="#8C8C8C", $borderColor="#6E6E6E", $legendText="существующая система банка")
AddElementTag("ml", $bgColor="#1E6B52", $borderColor="#14513D", $legendText="контейнер с обучаемым звеном")

title ИН-01. Сервис приоритизации разбора помеченных операций · C4 Container

Person(analyst, "Аналитик финмониторинга", "Разбирает операции по очереди; решает об эскалации, приостановке, фиксации")
Person(head, "Руководитель службы ФМ", "Владелец очереди и уровня автоматизации")
Person(owner, "Владелец сервиса / дежурный", "Алерты, переключение в ограниченный режим")
Person(ds, "DS/ML-инженер", "Обучение, приёмка, выкат версий")

System_Ext(abs, "АБС", "Операции, счета, контрагенты", $tags="existing")
System_Ext(kyc, "Платформа «Знай своего клиента»", "Внешний поставщик: уровень риска клиента")
System_Ext(dwh, "Хранилище данных банка", "История операций, справочники тарифов и лимитов", $tags="existing")
System_Ext(fm, "Система финмониторинга", "Пороговые правила, очередь разбора, карточка операции, решения аналитиков", $tags="existing")

System_Boundary(prod, "Боевой контур банка (on-premises)") {
  ContainerQueue(bus, "Брокер событий", "брокер сообщений", "«Операция помечена»; повторная доставка; ключ идемпотентности")
  Container(feat, "Сервис признаков", "сервис, обычный код", "Агрегаты по клиенту и паре «клиент — контрагент» на момент постановки; накопительные проверки на дробление; признаки из назначения по словарю")
  ContainerDb(fstore, "Хранилище признаков", "реляционная БД", "Снимки признаков с версией набора и временем расчёта")
  Container(prio, "Сервис приоритизации", "сервис", "Проверка входа, оценка моделью, калибровка, политика очереди, контракт выхода, резервный порядок", $tags="ml")
  ContainerDb(reg, "Реестр моделей и конфигурации", "хранилище артефактов", "Утверждённые версии модели, калибровки, словаря, порогов; флаг ограниченного режима")
  ContainerDb(log, "Журнал оценок и решений", "реляционная БД", "Вход, версии, оценка, позиция, решение аналитика; ограниченный доступ и срок")
  Container(mon, "Мониторинг", "метрики и алерты", "Сигналы по слоям: вход, модель, очередь, бизнес-метрика")
}

System_Boundary(dsz, "Аналитический контур банка (среда DS)") {
  ContainerDb(labels, "Витрина меток", "реляционная БД", "Метки с источником (очередь / контроль), автором и версией гайдлайна")
  Container(train, "Конвейер обучения и приёмки", "пакетные задания", "Обучение К1/К2, калибровка, приёмка по сценариям С1–С8, теневой прогон", $tags="ml")
}

Rel(abs, dwh, "[ГД-2] Операции с назначением платежа: свободный текст клиента", "существующий поток", $tags="trust")
Rel(fm, bus, "Публикует «операция помечена»", "асинхронно")
Rel(bus, prio, "Доставляет событие", "асинхронно")
Rel(prio, feat, "Запрашивает признаки на момент постановки", "синхронно, тайм-аут")
Rel(feat, dwh, "Читает историю и справочники")
Rel(kyc, feat, "[ГД-1] Уровень риска клиента", "по договору", $tags="trust")
Rel(feat, fstore, "Пишет снимок признаков")
Rel(prio, reg, "Читает утверждённую версию и флаг режима")
Rel(prio, fm, "[ГД-3] Приоритет, класс размещения, коды причин", "только поле приоритета", $tags="trust")
Rel(prio, log, "Пишет вход, версии, оценку, позицию")
Rel(analyst, fm, "Разбирает очередь, фиксирует решение и причину")
Rel(fm, labels, "[ГД-5] Решения аналитиков как метки", "ежедневно", $tags="trust")
Rel(dwh, train, "[ГД-6] Минимизированная копия истории и признаков", "пакетно", $tags="trust")
Rel(labels, train, "Метки для обучения и оценки")
Rel(train, reg, "[ГД-4] Артефакт модели после приёмки: подпись, утверждение", $tags="trust")
Rel(ds, train, "Запускает обучение и приёмку")
Rel(prio, mon, "Метрики модели и выхода")
Rel(feat, mon, "Метрики входа")
Rel(mon, owner, "Алерты: вход, модель, доступность")
Rel(mon, head, "Алерты: очередь, бизнес-метрика")
Rel(owner, reg, "Включает ограниченный режим", "без выката")

SHOW_LEGEND()
@enduml
