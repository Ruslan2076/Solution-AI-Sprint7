@startuml c4-in18-container
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
AddRelTag("trust", $lineColor="#C0392B", $textColor="#C0392B", $lineStyle=DashedLine(), $legendText="граница доверия ГД-N")
AddElementTag("existing", $bgColor="#8C8C8C", $borderColor="#6E6E6E", $legendText="существующая система банка")
AddElementTag("ml", $bgColor="#1E6B52", $borderColor="#14513D", $legendText="контейнер с обучаемым звеном")
AddElementTag("cond", $bgColor="#B07D2B", $borderColor="#8A611F", $legendText="внешний вариант, только при ответе «да» на ВЮ-08")

title ИН-18. Извлечение финансовых показателей · C4 Container

Person(client, "Заёмщик", "Присылает пакет документов к заявке")
Person(uw, "Андеррайтер", "Проверяет и подтверждает показатели; решение по заявке")
Person(owner, "Владелец сервиса / дежурный", "Алерты, ограниченный режим")

System_Ext(los, "Кредитная система", "Заявки, пакеты документов, карточка заёмщика", $tags="existing")
System_Ext(prov, "Модель извлечения в выделенном российском контуре провайдера", "Регион РФ, без хранения и обучения, закреплённая версия", $tags="cond")

System_Boundary(bank, "Контур банка") {
  ContainerQueue(inq, "Очередь пакетов", "брокер сообщений", "Пакет поступил; ключ: хеш документа и версия конвейера")
  Container(router, "Маршрутизатор формата", "обычный код", "Excel и выгрузки, PDF с текстовым слоем, скан или фото")
  Container(parsers, "Парсеры", "обычный код", "Excel, выгрузки известных бухгалтерских систем, PDF с текстом")
  Container(ocr, "Сервис распознавания", "готовая модель распознавания", "Страницы, блоки, координаты, уверенность, версия движка", $tags="ml")
  ContainerDb(canon, "Хранилище канонических документов", "хранилище документов", "Переиспользуется всеми сценариями; документ читается один раз")
  Container(min, "Минимизация", "обычный код", "Отбор страниц с финансовыми таблицами; маскирование ФИО, паспортных данных, адресов, подписей")
  Container(adapter, "Адаптер модели извлечения", "обычный код", "Единая схема ответа, тайм-ауты, лимиты, версия модели и инструкции; кеш по хешу документа")
  Container(local, "Модель извлечения on-premises", "open-weight модель", "Ветка при ВЮ-08 «нет»", $tags="ml")
  Container(valid, "Валидатор и нормализация", "обычный код", "Схема, ссылки на блоки, единицы и периоды, контрольные соотношения отчётности, сверка итогов выписки")
  Container(card, "Сервис карточки показателей", "обычный код", "Предзаполненная карточка с подсветкой; подтверждение андеррайтером")
  ContainerDb(log, "Журнал", "реляционная БД", "Версии, вход после минимизации, ответ, правки андеррайтера; ограниченный срок")
  Container(mon, "Мониторинг", "метрики и алерты", "Вход, контракт, очередь андеррайтера, время на пакет")
}

Rel(client, los, "[ГД-7] Документы: недоверенный контент", $tags="trust")
Rel(los, inq, "Пакет заявки", "асинхронно")
Rel(inq, router, "Документ")
Rel(router, parsers, "Структурированные форматы")
Rel(router, ocr, "Сканы и фото")
Rel(parsers, canon, "Каноническое представление")
Rel(ocr, canon, "Каноническое представление")
Rel(canon, min, "Нефиксированные формы")
Rel(canon, valid, "Значения из парсеров")
Rel(min, adapter, "Минимизированный текст")
Rel(adapter, prov, "[ГД-8] Минимизированный текст за контур", "только при ВЮ-08 «да»", $tags="trust")
Rel(adapter, local, "Минимизированный текст", "ветка on-premises")
Rel(adapter, valid, "[ГД-9] Ответ модели: недоверенный ввод", $tags="trust")
Rel(valid, card, "Прошедшие проверку значения и подсветка непрошедших")
Rel(card, los, "Карточка показателей")
Rel(uw, card, "Подтверждает или правит, со ссылкой на источник")
Rel(valid, log, "Результаты проверок")
Rel(card, log, "Правки андеррайтера")
Rel(valid, mon, "Метрики")
Rel(mon, owner, "Алерты")

SHOW_LEGEND()
@enduml
