@startuml c4-in08-container
!include <C4/C4_Container>
LAYOUT_TOP_DOWN()
AddRelTag("trust", $lineColor="#C0392B", $textColor="#C0392B", $lineStyle=DashedLine(), $legendText="граница доверия ГД-N")
AddElementTag("existing", $bgColor="#8C8C8C", $borderColor="#6E6E6E", $legendText="существующая система банка")
AddElementTag("ml", $bgColor="#1E6B52", $borderColor="#14513D", $legendText="контейнер с обучаемым звеном")

title ИН-08. Прогноз ухода клиента · C4 Container

Person(mgr, "Менеджер МСБ", "Связывается с клиентами из списка, фиксирует исход")
Person(prod, "Владелец продукта МСБ", "Ёмкость удержания K, владелец риска")
Person(ds, "DS/ML-инженер", "Обучение, приёмка, выкат")

System_Ext(dwh, "Хранилище данных банка", "Операции, остатки, продукты, статусы клиентов", $tags="existing")
System_Ext(crm, "CRM", "Задачи менеджерам, исходы контактов", $tags="existing")

System_Boundary(an, "Аналитический контур банка (on-premises)") {
  Container(labeler, "Расчёт меток", "пакетные задания, обычный код", "Метки А и Б по правилу; исключения: ликвидация, расторжение по инициативе банка")
  Container(feat, "Витрина признаков клиента", "пакетные задания, обычный код", "Месячные окна оборотов, операций, остатков, обращений; без сведений о мерах финмониторинга")
  Container(train, "Конвейер обучения и приёмки", "пакетные задания", "К1/К2 против правила, сценарии по сегментам", $tags="ml")
  ContainerDb(reg, "Реестр моделей", "хранилище артефактов", "Утверждённые версии модели и правила метки")
  Container(score, "Пакетный скоринг", "ежемесячное задание", "Оценка вероятности ухода по всем активным клиентам", $tags="ml")
  Container(list, "Формирование списка", "обычный код", "Исключения, отсечка K, случайная контрольная группа, коды причин")
  ContainerDb(store, "Оценки, списки и исходы", "реляционная БД", "Версии, оценка, группа (контакт / контроль), исход контакта")
  Container(mon, "Мониторинг", "метрики и алерты", "Дрейф признаков, точность верхушки, удержание: контакт против контроля")
}

Rel(dwh, labeler, "История статусов и оборотов")
Rel(dwh, feat, "Операции, остатки, продукты")
Rel(labeler, train, "Метки")
Rel(feat, train, "Признаки за историю")
Rel(train, reg, "[ГД-11] Артефакт после приёмки", $tags="trust")
Rel(ds, train, "Запускает")
Rel(reg, score, "Утверждённая версия")
Rel(feat, score, "Признаки на дату оценки")
Rel(score, list, "Оценки")
Rel(list, crm, "[ГД-10] Список K с кодами причин за пределы аналитического контура", "ежемесячно", $tags="trust")
Rel(list, store, "Группы и версии")
Rel(mgr, crm, "Контакты и исходы")
Rel(crm, store, "Исходы контактов")
Rel(store, mon, "Метрики")
Rel(mon, prod, "Алерты по эффекту и нагрузке")

SHOW_LEGEND()
@enduml
